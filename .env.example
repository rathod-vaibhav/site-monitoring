DJANGO_SECRET_KEY=replace-this
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Gmail SMTP Configuration Example:
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Use port 587 with TLS=1 and SSL=0:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=your_email@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Site Monitoring
EMAIL_BCC=
